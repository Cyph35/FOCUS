# Copy to .env.local for local development. Never commit real secrets.
# Replace every value below with YOUR actual values before use.

# Required for admin dashboard login. Use a unique username and a long random password.
# The main account sees ALL strands.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_long_random_admin_password

# Required for the Engineering adviser login. This account only ever sees
# submissions whose grade_level is '11 Academic-Engineering'.
ENGINEERING_ADMIN_USERNAME=your_engineering_admin_username
ENGINEERING_ADMIN_PASSWORD=your_long_random_engineering_password

# Required for the Medical adviser login. This account only ever sees
# submissions whose grade_level is '11 Academic-Medical'.
MEDICAL_ADMIN_USERNAME=your_medical_admin_username
MEDICAL_ADMIN_PASSWORD=your_long_random_medical_password

# Required for the STEM adviser login (Grade 12 STEM strand). This account only
# ever sees submissions whose grade_level is '12 Academic-STEM'.
STEM_ADMIN_USERNAME=your_stem_admin_username
STEM_ADMIN_PASSWORD=your_long_random_stem_password

# Required HMAC secret for post-submit evaluation updates. Use at least 32 random characters.
EVALUATION_TOKEN_SECRET=replace_with_a_32_char_random_secret

# Required server-side Supabase access (service role stays on the server only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional. Only needed if browser code talks to Supabase directly.
# Do not put the service role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional. Set only if the app is hosted under a subpath (not Vercel root).
# VITE_BASE_PATH=/
